PORT=5000
DATABASE_URL="postgresql://user:pass@localhost:5432/neatresume"
JWT_SECRET=           # Generate: openssl rand -hex 32
JWT_REFRESH_SECRET=   # Generate: openssl rand -hex 32
GEMINI_API_KEY=       # From Google AI Studio
GITHUB_CLIENT_ID=     # From GitHub OAuth App
GITHUB_CLIENT_SECRET= # From GitHub OAuth App
GITHUB_ENCRYPTION_KEY= # Generate: openssl rand -hex 32
NODE_ENV=development

# CORS – comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (Vercel frontend):
# ALLOWED_ORIGINS=https://neat-resume-smoky.vercel.app

# Frontend origin (used for GitHub OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://neat-resume-smoky.vercel.app
