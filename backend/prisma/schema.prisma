generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  refreshTokens RefreshToken[]
  resumes       Resume[]
  githubAccessToken   String?
  githubUsername      String?
  githubConnectedAt   DateTime?
  atsUploads          AtsResumeUpload[]
  atsOptimized        AtsOptimizedResume[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  templateId    String
  parsedData    Json
  schemaVersion String   @default("1.0.0")
  atsScore      Int?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  portfolioUrl    String?
  portfolioStatus String?
  deployedAt      DateTime?

  @@index([userId])
  @@index([isDeleted])
}

// ── ATS Optimizer (separate from Resume / deployer) ──────────────────────────

/// Stores an original PDF uploaded specifically for ATS optimization.
/// Completely separate from the dashboard Resume model.
model AtsResumeUpload {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  parsedData  Json
  atsScore    Int?
  pdfBuffer   Bytes    // store original PDF for rendering/download
  createdAt   DateTime @default(now())

  optimizedVersions AtsOptimizedResume[]

  @@index([userId])
}

/// Stores a JD-optimized version of an AtsResumeUpload.
/// parsedData has the reworded content; pdfBuffer has the rebuilt PDF.
model AtsOptimizedResume {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId      String
  source        AtsResumeUpload @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  companyName   String
  roleTitle     String
  parsedData    Json
  atsScore      Int?
  pdfBuffer     Bytes           // rebuilt PDF with optimized content
  jdDictionary  Json
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([sourceId])
}
